# Local/demo defaults. Never use these values for a production deployment.
ENVIRONMENT=development
AUTO_CREATE_DB=true
ALLOW_DEMO_AUTH=true
JWT_SECRET=replace-with-a-long-random-secret-before-deploy
POSTGRES_PASSWORD=mathia-local

# Managed OIDC provider (Clerk or Supabase Auth)
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# LiteLLM: openai/..., anthropic/..., or mistral/...
LLM_PROVIDER=demo
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_REQUESTS_PER_USER_PER_DAY=80
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Mathpix is called only when explicitly enabled and a parent consent is active.
ENABLE_EXTERNAL_OCR=false
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Optional observability. Raw free-text answers are excluded from traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
